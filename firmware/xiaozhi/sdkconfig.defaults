CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=1024
CONFIG_COMPILER_CXX_RTTI=y

CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=2048

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y

# These entries are copied from ESP-HI (ESP32C3) to reduce memory usage
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

# Fix ML307 FIFO Overflow
CONFIG_UART_ISR_IN_IRAM=y

# Fix ESP_SSL error
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n

# LVGL 9.2.2

CONFIG_LV_OS_NONE=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_IMGFONT=y
CONFIG_LV_USE_ASSERT_STYLE=y

# Use compressed font
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_FONT_COMPRESSED=n
CONFIG_LV_USE_FONT_PLACEHOLDER=n
CONFIG_LV_USE_LODEPNG=y

# Disable extra widgets to save flash size
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CALENDAR_HEADER_ARROW=n
CONFIG_LV_USE_CALENDAR_HEADER_DROPDOWN=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n

CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n


# --- 立创·实战派 ESP32-S3 ---
CONFIG_BOARD_TYPE_LICHUANG_DEV_S3=y
CONFIG_USE_DEVICE_AEC=y

# --- 离线语音命令词（esp-sr MultiNet）---
#
# 为什么必须切到 USE_CUSTOM_WAKE_WORD（而不是只加模型）：
#   audio_service.cc SetModelsList() 运行时按**模型内容**选唤醒词实现 ——
#   看到 mn* 模型就用 CustomWakeWord，否则用 AfeWakeWord。而
#   build_default_assets.py 也只在 USE_CUSTOM_WAKE_WORD 时才把 multinet
#   模型打进 assets。只开模型不开这个开关，模型根本不会被打包。
#
# 为什么 CUSTOM_WAKE_WORD 要写成「你好小智」的拼音：
#   切到 CustomWakeWord 后唤醒词由 MultiNet 识别，不再是专用 WakeNet。
#   短语本身必须保持不变 —— 老人和子女的肌肉记忆是产品资产，
#   不能因为换了识别引擎就换词。Kconfig 要求中文写拼音、空格分隔。
CONFIG_USE_CUSTOM_WAKE_WORD=y
CONFIG_CUSTOM_WAKE_WORD="ni hao xiao zhi"
CONFIG_CUSTOM_WAKE_WORD_DISPLAY="你好小智"
CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20
# mn7_cn：官方推荐版本（S3/P4），比 mn6_cn 小约 1MB。
# 模型字节数 = mn7_data 2659972 + mn7_index 4656 + vocab 6601 = 2671229，
# 连同 fst 共 2680877 字节打进 assets 分区（8MB，当前余量充足）。
CONFIG_SR_MN_CN_MULTINET7_QUANT=y

# >>> BEGIN elder-companion overlay (由 tools/merge_to_xiaozhi.py 注入，勿手改) >>>
# 目标板卡：立创·实战派 ESP32-S3
CONFIG_BOARD_TYPE_LICHUANG_DEV_S3=y
# 表情/形象走 EAF 序列帧（esp_emote_gfx），只有开启它 EmoteDisplay 才会被实例化
CONFIG_USE_EMOTE_MESSAGE_STYLE=y
# 与后端 TZ=Asia/Shanghai 对齐的提示音语言
CONFIG_LANGUAGE_ZH_CN=y
# 16MB Flash + Octal PSRAM（立创·实战派 N16R8）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# 分区表：v2/16m.csv（含 8MB assets 分区，存放 EAF 形象包）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
# 业务后端地址（按实际部署修改，也可 idf.py menuconfig 调整）
CONFIG_ELDER_SERVER_URL="http://192.168.1.100:8000"
CONFIG_ELDER_SERVER_TOKEN=""
CONFIG_ELDER_SYNC_INTERVAL_SEC=300
CONFIG_ELDER_HTTP_TIMEOUT_MS=8000
# 立创板无板载 WS2812；外接灯珠时才打开
CONFIG_ELDER_ENABLE_RGB=n
# 演示提醒数据（无后端联调时可临时打开）
CONFIG_ELDER_DEMO_DATA=n
# xiaozhi 的 OTA/WS 地址由后端 /api/device/sync 下发，此处保持默认即可
# <<< END elder-companion overlay <<<
