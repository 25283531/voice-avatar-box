# 复制为 .env 后按需修改：cp .env.example .env
#
# 默认形态是**内置 SQLite**，不设任何变量也能 `docker compose up -d` 直接跑起来。
# 想用 MySQL 再看下面的 MYSQL 段，并叠加 docker-compose.mysql.yml。
# 完整说明见 ../docs/DEPLOY.md

# ---- 数据库（内置 SQLite，默认即可）----
# 留空 = 内置 SQLite：容器里落在命名卷的 /data/elder.db，本机裸跑落在 ./elder.db。
# 持久化目录可用 ELDER_DATA_DIR 覆盖（例如挂到宿主机目录）：
#   ELDER_DATA_DIR=/mnt/nas/elder
# 要换成 MySQL 就填连接串（自带容器 / 外部实例都行）：
#   ELDER_DB=mysql+pymysql://root:123456@elder-db:3306/elder_companion?charset=utf8mb4
#   ELDER_DB=mysql+pymysql://elder:Pass@10.0.0.7:3306/elder_companion?charset=utf8mb4
# 注意：密码里的 @ : / # 要做 URL 转义（%40 %3A %2F %23）；charset=utf8mb4 不要省。

# ---- MySQL（只在用自带 elder-db 容器时需要）----
MYSQL_ROOT_PASSWORD=123456
# 后端启动时最多等待数据库可用的秒数。MySQL 8 首次初始化数据目录可能要 30~90s；
# 等待不足会看到 (2013, 'Lost connection to MySQL server during query')。
# 这个值对 SQLite 无效（本地文件无需等待）。
ELDER_DB_WAIT_SEC=180

# ---- 业务后端 ----
# 对外发布端口（容器内固定 8080，宿主机默认 8064，避免与常用 8080 冲突）
ELDER_HTTP_PORT=8064
# 生产环境务必改成随机长字符串
ELDER_JWT_SECRET=please-change-this-secret-in-production
# 允许跨域的来源，多个用逗号分隔；上线后建议填 https://voice.2508866.xyz
ELDER_CORS=*
# 服药提醒是时间强相关业务，服务端/设备端/展示层必须同一时区
ELDER_TZ=Asia/Shanghai
# 设备看到的语音服务地址（内网部署时填局域网地址）
ELDER_XIAOZHI_WS=ws://192.168.1.10:8000/xiaozhi/v1/
ELDER_XIAOZHI_OTA=http://192.168.1.10:8003/xiaozhi/ota/
# 会员订单（人工核销）占用有效期（小时），超时置 expired 并释放号段与金额
ELDER_ORDER_TTL_HOURS=48
