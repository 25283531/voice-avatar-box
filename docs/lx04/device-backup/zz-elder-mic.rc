# ============================================================================
# 老人陪伴助手（com.elder.lx04）—— 释放麦克风
#
# 部署位置：/vendor/etc/init/zz-elder-mic.rc
# 回退方式：rm /vendor/etc/init/zz-elder-mic.rc && reboot
#
# ---------------------------------------------------------------------------
# 为什么需要这个文件
# ---------------------------------------------------------------------------
# /vendor/etc/init/hw/init.project.rc 里定义了：
#
#     service mivpm /system/bin/MiVpmService
#         class late_start
#         user root
#         group system
#
# 这是小爱的唤醒引擎，开机就起，常驻 16kHz 录音
# （dumpsys media.audio_flinger 里 Input thread AudioIn_1E，Standby: no）。
#
# 实测（2026-11-04，设备 10.0.1.184）它对**我们的**采集有抑制作用。
# 同一台机器、同一段代码、相隔一分钟，唯一变量是 mivpm：
#
#     mivpm running → mic_test 峰值 rms = 7      （基本等于静音）
#     mivpm stopped → mic_test 峰值 rms = 6349   （正常语音电平）
#
# 两次都不是 0，说明 AudioRecord 本身打开成功、帧也读满了 166 帧 ——
# 不是"打不开"，而是"打开了但拿不到信号"。所以必须让它不跑。
#
# ---------------------------------------------------------------------------
# 为什么不直接改 init.project.rc
# ---------------------------------------------------------------------------
# 那是原厂文件，改它有两个问题：
#   1. 以后 OTA / 刷机回滚时容易和原厂内容冲突，看不出改过什么
#   2. 出问题没法一键还原
# 新增一个独立文件，删掉它就恢复原样 —— 整个系统改动只有这一个文件。
#
# ---------------------------------------------------------------------------
# 为什么用 property 触发而不是只在 boot_completed 停一次
# ---------------------------------------------------------------------------
# 服务是 late_start 类，起来的时间点不确定；而且如果有别的东西把它拉起来，
# 只 stop 一次不够。监听 init.svc.mivpm=running 能做到"它一冒头就按下去"。
# boot_completed 那条是兜底，防止某些路径下属性回调没触发。
#
# ⚠️ 这个服务没有 critical 标志，stop 它不会触发系统重启。
# ============================================================================

on property:init.svc.mivpm=running
    stop mivpm

on property:sys.boot_completed=1
    stop mivpm
