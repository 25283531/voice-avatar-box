# 变量必须以 VITE_ 为前缀才能暴露给外部读取
# 本项目只面向中文用户，界面文案在 src/i18n/zh_CN.ts 内维护

VITE_APP_TITLE = '老人陪伴助手'
VITE_APP_PORT = 9000

# uni-app 应用标识（DCloud 开发者后台申请）
VITE_UNI_APPID = '__UNI__26FECA2'

# h5 部署网站的 base，配置到 manifest.config.ts 里的 h5.router.base
# WebView 壳加载本地 assets 时需要相对路径，CI 构建 APK 时会用 ./. 覆盖
VITE_APP_PUBLIC_BASE=/

# ---------------------------------------------------------
# 业务后端地址（服务端接口 + 业务接口统一域名）
# 注意：真实地址在 src/http/elder.ts 里代码级写死，此处仅作留档，
#       APP 不提供任何"服务地址 / 网络设置"入口。
VITE_ELDER_BASEURL = 'https://voice.2508866.xyz'

# h5 开发代理：默认关闭（直连写死的业务后端）
VITE_APP_PROXY=false
VITE_APP_PROXY_PREFIX = '/api'
