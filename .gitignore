# ---------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# ---------------------------------------------------------- 本地数据 / 密钥
.env
# app/env/.env 必须入库：手机端的后端地址写在这里（无密钥，只有 URL）
!app/env/.env
*.db
*.sqlite3
# SQLite 的 WAL / journal 伴生文件（进程被强杀时会残留）
*.db-journal
*.db-wal
*.db-shm
*.log

# ---------------------------------------------------------- Node / 前端
node_modules/
app/dist/
app/unpackage/
app/.hbuilderx/
.stylelintcache
.eslintcache
*.local

# ---------------------------------------------------------- 固件（ESP-IDF）
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/dependencies.lock
firmware/managed_components/
firmware/*.bin
firmware/*.elf
firmware/*.map

# 上游 xiaozhi 镜像的构建产物（managed_components 由 IDF 组件管理器自动拉取，约 509MB）
firmware/xiaozhi/build/
firmware/xiaozhi/managed_components/
firmware/xiaozhi/sdkconfig
firmware/xiaozhi/sdkconfig.old
firmware/xiaozhi/components/elder/
# 组件管理器删「无用组件」时会撞本机删除守卫（按文件数批量拦截），
# 规避方式是先 Move-Item 移到这里暂存（可逆、不改阈值），构建后可直接删
firmware/xiaozhi/.mc_stash/

# LVGL 9.3.0 的本地副本（约 159MB，不进 git）。
# 由 tools/fetch_lvgl.py 下载并按内容校验后生成；main/idf_component.yml 里
# lvgl 通过 override_path 指向它，这样组件管理器走 LocalSource、不去注册表，
# 避免被求解器抬到 9.6（9.6 的 lv_font_t 布局与 cbin 字库不兼容 → 白屏）。
third_party/lvgl/

# CI 冒烟脚本的落盘日志（tools/run_smoke.py 写，红灯时随 artifact 上传）
logs/

# ---------------------------------------------------------- 杂项
# QA 补丁前备份 / 临时探针：一次性产物，历史已踩过「临时脚本混进 commit 后
# 自删、留下无法解释的历史」，一律不入库
tools/_orig_*
tools/_tmp_*
# 本地会话/记忆数据，不进仓库
.workbuddy/
# AI 助手的工作区记忆（memory/ 日志、临时产物）。与 .workbuddy/ 同一性质：
# 是本机会话状态，不是项目内容 —— 提交上去只会给 review 添噪音。
.workbuddy-ai/
Setup Log*.txt
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 签名证书（私钥，绝不能入库）
*.keystore
*.jks
*.p12
*.mobileprovision

# 签名证书（私钥，绝不入库）
*.keystore
*.jks
*.p12
*.mobileprovision

# 本地下载的构建产物
out/
# 仓库根的 dist/（从 Actions 下载的 APK/固件整包暂存，2026-10-19 QA 发现
# 只有 app/dist/ 被规则命中而根 dist/ 漏网，48MB 二进制有误入库风险）
dist/
